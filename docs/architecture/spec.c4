// Element kinds, tags, and styles shared by every view.
specification {
  element actor {
    style {
      shape person
    }
  }
  element system
  element container
  element component
  element library {
    style {
      shape component
    }
  }
  element store {
    style {
      shape storage
    }
  }

  // Designed but not implemented yet.
  tag planned
  // Owned by unmango/game; drawn here only where the game touches it.
  tag framework
}
